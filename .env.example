# Velox settings for local development. Copy it: cp .env.example .env
# Every setting is explained in docs/self-host.md#settings.

# ─── Required ────────────────────────────────────────────────────────────────

# Postgres URL of the admin user, used for database upgrades (migrations).
DATABASE_URL=postgres://velox:velox@localhost:5432/velox?sslmode=disable

# ─── Required in production ──────────────────────────────────────────────────
# APP_ENV=production refuses to start without these. Local development works without them.

# local | staging | production. Set production on a real server.
APP_ENV=local

# Postgres URL of the limited user (velox_app) that requests run as. Also required in staging. Unset locally: velox_app:velox_app on DATABASE_URL.
APP_DATABASE_URL=

# Encrypts personal data and Stripe keys. 64 hex characters: openssl rand -hex 32
VELOX_ENCRYPTION_KEY=

# Redis, used only for rate limiting. `make up` starts it on port 6379.
REDIS_URL=redis://localhost:6379

# Addresses (IPs or CIDRs) of your proxy or load balancer, comma-separated, or `none`. Empty: the direct peer is the client.
TRUST_PROXY=

# ─── Email ───────────────────────────────────────────────────────────────────
# Without SMTP_HOST no email is sent. Other providers: docs/ops/email-setup.md

# Mailpit catches every email locally; read them at http://localhost:8025. `make up` starts it.
SMTP_HOST=localhost
SMTP_PORT=1025
# starttls (port 587, the default) | implicit (port 465) | none (local only; refused in production).
SMTP_TLS=none
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=billing@velox.local

# User name and password for the Postmark bounce webhook. Empty: the webhook answers 401.
POSTMARK_WEBHOOK_USER=
POSTMARK_WEBHOOK_PASS=

# Lets Velox find a customer by email, for bounces. 64 hex characters, not the encryption key: openssl rand -hex 32
VELOX_EMAIL_BIDX_KEY=

# ─── URLs ────────────────────────────────────────────────────────────────────
# Where links in emails and Stripe redirects point. Here: the dashboard dev server on :5173.

# The "add a payment method" email link. Velox adds ?token=…
PAYMENT_UPDATE_URL=http://localhost:5173/update-payment

# Where a customer lands after adding a card from that email.
PAYMENT_UPDATE_RETURN_URL=http://localhost:5173/payment-method-added

# Where Stripe sends a customer after saving a card. Empty: http://localhost:5173.
CUSTOMER_PORTAL_URL=http://localhost:5173

# The "View & pay invoice" link in emails. Empty: emails have no link.
HOSTED_INVOICE_BASE_URL=http://localhost:5173

# Password-reset and team-invite links. Empty: those emails are not sent.
DASHBOARD_BASE_URL=http://localhost:5173

# This API's public address, for the shareable cost-dashboard link. Empty: the link is a relative path.
VELOX_API_BASE_URL=

# ─── Optional ────────────────────────────────────────────────────────────────

# Server port.
PORT=8080

# Apply database upgrades at start-up.
RUN_MIGRATIONS_ON_BOOT=true

# How long a database upgrade waits for a table lock before it stops
# (default 5s; 0 = no limit). See docs/ops/runbook/migration-lock-timeout.md.
# MIGRATION_LOCK_TIMEOUT=5s

# debug | info | warn | error. debug also logs each background job run.
LOG_LEVEL=info

# How long after a billing period ends its invoice is built, so late usage is billed. 0 to 72h; default 1h.
# INVOICE_GRACE_PERIOD=1h

# Allows the POST /v1/bootstrap call that creates the first account: openssl rand -hex 32
VELOX_BOOTSTRAP_TOKEN=

# Read by `make bootstrap`, not by the server. Defaults: admin@velox.local, a generated password, "Demo Tenant".
# VELOX_BOOTSTRAP_EMAIL=admin@velox.local
# VELOX_BOOTSTRAP_PASSWORD=choose-a-password
VELOX_BOOTSTRAP_TENANT=

# Sign-in cookie domain. Empty: this host only, right for localhost. Use .example.com when the API is on another subdomain.
VELOX_COOKIE_DOMAIN=

# Browser origins allowed to call the API, comma-separated.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174

# Bearer token for GET /metrics. Empty: open locally and in staging, 401 in production.
METRICS_TOKEN=

# Rate limits: requests per key per minute, and usage events per key per second.
# VELOX_RATE_LIMIT_GENERAL_PER_MIN=100
# VELOX_RATE_LIMIT_INGEST_PER_SEC=1000

# Stripe is not set here: each account connects its own in the dashboard, under Settings → Payments.
