{
  "name": "web-v2",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "npm run copy-spec",
    "dev": "vite",
    "prebuild": "npm run copy-spec",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "lint": "eslint . && npx knip",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "copy-spec": "node scripts/copy-openapi-spec.mjs",
