// knip finds unused files, exports, types and dependencies. `npm run lint`
// runs it, so new dead code fails CI. Each ignore below says why it stays.
{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "ignoreExportsUsedInFile": true,
  // The vite, vitest, playwright, eslint and orval plugins find the other
  // entry files on their own.
  "entry": ["tests/**/*.test.ts", "e2e/**/*.spec.ts", "e2e/global.setup.ts", "scripts/*.mjs"],
  // css is included so knip follows index.css's @imports (tailwindcss,
  // tw-animate-css, shadcn).
  "project": ["src/**/*.{ts,tsx,css}", "tests/**/*.ts", "e2e/**/*.ts"],
  "ignore": [
    // Generated by `npm run gen`: every route gets hooks, used or not.
    "src/lib/gen/**",
    // Vendored shadcn components, kept whole.
    "src/components/ui/**"
  ],
  "ignoreFiles": [
    // Whether to keep the openapi-typescript output is a separate decision.
    "src/lib/api.gen.ts",
    // Kept until we decide whether the pages adopt them.
    "src/components/page/PageHeader.tsx",
    "src/components/page/DetailLayout.tsx"
  ],
  "ignoreDependencies": [
    // Sets the version react-router-dom runs on (a security bump), and the
    // react-router-dom imports are to move to it before React Router v8.
    "react-router",
    // A peer dependency of orval's OpenAPI parser (ajv-draft-04,
    // ajv-formats). `npm ci --legacy-peer-deps` does not install peers.
    "ajv"
  ]
}
